# Built binaries. `aria` has no extension on Unix, so the wildcards below do not
# cover it.
/aria
/aria.exe
*.exe
*.dll
*.so
*.dylib

# Test binaries and fuzz corpora. A corpus entry is only useful alongside the
# failing input it was minimised from, which belongs in a test instead.
*.test
**/testdata/fuzz/

# System and IDE files
.idea
.vscode
.DS_STORE

# Scratch files
source.ari

